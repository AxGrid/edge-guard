# edge-guard: lets only edge nodes reach your services, 403 Forbidden to others.
# install.sh does all of this:
#   useradd --system --no-create-home --shell /usr/sbin/nologin edge-guard
#   install -m 755 edge-guard /usr/local/bin/edge-guard
#   install -d -m 750 -g edge-guard /etc/edge-guard && install -m 640 -g edge-guard config.yaml /etc/edge-guard/
#   install -m 600 /dev/null /etc/edge-guard/env   # then: SHOP_KEY=<origin-auth secret>
#   (key_file and TLS keys: root:edge-guard, mode 640)
#   edge-guard -check -online -config /etc/edge-guard/config.yaml
#   systemctl enable --now edge-guard
# Config changes are picked up by themselves (or: systemctl reload edge-guard).
[Unit]
Description=edge-guard (only edge nodes may reach the services)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/edge-guard/env
ExecStart=/usr/local/bin/edge-guard -config /etc/edge-guard/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
StateDirectory=edge-guard
Restart=always
RestartSec=3
User=edge-guard
Group=edge-guard
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# ports below 1024 (listen: ":443")
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
